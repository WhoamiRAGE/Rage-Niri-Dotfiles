{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "separator": ""
  },
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/frieren.txt",
    "color": {
      "1": "#cccccc",
      "2": "#cccccc",
      "3": "#cccccc",
      "4": "#cccccc",
      "5": "#cccccc"
    },
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "modules": [
    "break",
    {
      "type": "command",
      "key": "󰀄 USER",
      "keyColor": "#cccccc",
      "text": "echo $USER@$(hostnamectl hostname)"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "#cccccc",
      "format": "{name} {version-id}"
    },
    {
      "type": "command",
      "key": "󰌽 KER",
      "keyColor": "#cccccc",
      "text": "echo $(uname -r | cut -d- -f1) $(uname -m)"
    },
    {
      "type": "de",
      "key": "󰧨 DE",
      "keyColor": "#cccccc"
    },
    {
      "type": "wm",
      "key": "󰕮 WM",
      "keyColor": "#cccccc"
    },
    {
      "type": "packages",
      "key": "󰏗 PKG",
      "keyColor": "#cccccc",
      "format": "{all}"
    },
    {
      "type": "terminal",
      "key": "󰆍 TERM",
      "keyColor": "#cccccc",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "󰞷 SH",
      "keyColor": "#cccccc",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "keyColor": "#cccccc",
      "key": "󰥔 UP"
    },
    "break",
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "#cccccc",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "#cccccc",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "#cccccc",
      "format": "{used} / {total}"
    },
    {
      "type": "swap",
      "key": "󰓡 SWAP",
      "keyColor": "#cccccc",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "󰋊 SSD",
      "keyColor": "#cccccc",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "disk",
      "folders": "/mnt/games",
      "key": "󰋊 SSD2",
      "keyColor": "#cccccc",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "display",
      "key": "󰹑 RES",
      "keyColor": "#cccccc",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    "break",
    {
      "type": "command",
      "key": "󰢐 MESA",
      "keyColor": "#cccccc",
      "text": "pacman -Q mesa 2>/dev/null | awk '{print $2}'"
    },
    {
      "type": "command",
      "key": "󰾲 NVIDIA",
      "keyColor": "#cccccc",
      "text": "nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m \u001b[91m \u001b[92m \u001b[93m \u001b[94m \u001b[95m \u001b[96m \u001b[97m"
    },
    "break"
  ]
}